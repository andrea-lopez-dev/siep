*.cache
*.lock
cache/
logs/
temp/

# Carpetas de dependencias (si usas Composer)
vendor/

# Archivos subidos por usuarios (si aplica)
files/uploads/
files/temp/

# Configuración de VS Code (opcional)
.vscode/
.idea/
